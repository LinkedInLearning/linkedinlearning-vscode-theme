{
  "name": "linkedinlearning-vscode-theme",
  "displayName": "LinkedIn Learning Theme",
  "description": "Accessible light and dark variant theme for VS Code",
  "version": "1.0.1",
  "publisher": "linkedinlearning",
  "author": {
    "name": "mor10",
    "url": "https://github.com/mor10"
  },
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0072b1",
    "theme": "dark"
  },
  "homepage": "https://github.com/linkedinlearning/linkedinlearning-vscode-theme/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/linkedinlearning/linkedinlearning-vscode-theme"
  },
  "bugs": {
    "url": "https://github.com/linkedinlearning/linkedinlearning-vscode-theme/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "light",
    "dark",
    "accessibility",
    "linkedinlearning"
  ],
  "files": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "themes/*.json",
    "icon.png",
    "images/linkedinlearning-vscode-theme.png"
  ],
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "test": "node --test",
    "format:check": "prettier --check package.json scripts test .github README.md CONTRIBUTING.md CHANGELOG.md",
    "check": "npm run format:check && npm test && npm run validate",
    "package": "npm run validate && vsce package --no-dependencies --out theme.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "4.1.1",
    "jsonc-parser": "3.3.1",
    "ovsx": "1.4.0",
    "prettier": "3.10.1"
  },
  "contributes": {
    "themes": [
      {
        "label": "LinkedIn Learning Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/linkedinlearning-dark-color-theme.json"
      },
      {
        "label": "LinkedIn Learning Light",
        "uiTheme": "vs",
        "path": "./themes/linkedinlearning-light-color-theme.json"
      }
    ]
  }
}
